{
  "permissions": {
    "allow": [
      "Bash(./scripts/test.sh:*)",
      "Bash(./scripts/build.sh:*)",
      "Bash(./scripts/bootstrap.sh:*)",
      "Bash(swift test:*)",
      "Bash(swift build:*)",
      "Bash(xcodegen generate:*)",
      "Bash(xcodebuild test:*)",
      "Bash(xcodebuild build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(./scripts/release.sh:*)",
      "Bash(./scripts/run.sh:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(**/.env)",
      "Edit(./.env)",
      "Bash(cat .env:*)",
      "Bash(cat ./.env:*)",
      "Bash(less .env:*)",
      "Bash(head .env:*)",
      "Bash(tail .env:*)",
      "Bash(grep * .env:*)",
      "Bash(source .env:*)",
      "Bash(printenv:*)"
    ]
  }
}
