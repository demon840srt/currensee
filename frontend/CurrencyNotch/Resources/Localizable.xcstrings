    "Already above — will notify on the next crossing.": {
      "extractionState": "manual",
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבר מעל — תודיע בחצייה הבאה."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already above — will notify on the next crossing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya está por encima: avisará en el próximo cruce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже выше — уведомление при следующем пересечении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已高于阈值——将在下次穿越时通知。"
          }
        }
      }
    },
