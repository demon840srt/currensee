# Copy to .env if you want to use these locally. NEVER commit .env.
# The app needs NO API keys or secrets (free, key-less rate sources; personal-use builds, ADR-0023).
# scripts/run.sh exports .env into the Debug app. All of these are Debug-only and compiled out of Release.

# Show a theme without changing saved settings: ice | fire | israel | classicNotch | frostedGlass
# CURRENCY_NOTCH_THEME=ice

# Run theme effects even on battery (for measurements).
# CURRENCY_NOTCH_IGNORE_BATTERY=1

# Keep only part of the theme effects: particles | shimmer
# CURRENCY_NOTCH_EFFECTS=particles
