# Copy to .env and fill in real values locally. NEVER commit .env.
# The app needs NO API keys — rate sources are free and key-less.
# These values are dummies. They are read only by scripts/run.sh (Debug overrides)
# and scripts/release.sh (signing + notarization).

# --- Debug overrides (optional; Release builds use compiled-in defaults) ---
RATES_PRIMARY_BASE_URL=https://api.coinbase.com/v2
RATES_FALLBACK_BASE_URL=https://api.frankfurter.dev/v2
RATES_REFRESH_SECONDS=120
CURRENCY_NOTCH_LOG_LEVEL=debug

# --- Release / distribution (secrets: real values only in your local .env) ---
DEVELOPER_ID_APPLICATION="Developer ID Application: Example Name (ABCDE12345)"
APPLE_TEAM_ID=ABCDE12345
# Name of a keychain profile created once with:
#   xcrun notarytool store-credentials <profile-name> --apple-id ... --team-id ...
NOTARY_KEYCHAIN_PROFILE=currency-notch-notary-dummy
